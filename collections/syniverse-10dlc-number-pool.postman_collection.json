    {
      "id": "f5d973da-800b-4a21-afe1-48cc447b9583",
      "name": "10DLC v1 Number Pools",
      "description": {
        "content": "Enhanced 10DLC Number Pool to Campaign Association Management",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b5667098-5806-4bdd-bb14-f4101f05cb84",
          "name": "Association of Campaign  with the Number Pool",
          "request": {
            "name": "Association of Campaign  with the Number Pool",
            "description": {
              "content": "Syniverse is required to update some MNO A2P platforms with the new Number Pool for a given campaign, enabling   customers to better manage campaigns with large groups of numbers. Number pools require carrier approvals and this API currently covers  2 types SubId and CampaignId.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "engage",
                "tendlc-services",
                "v1",
                "campaigns",
                ":campaignId",
                "pools",
                ":numberPoolId",
                "types",
                ":numberPoolType"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "campaignId",
                  "description": "(Required) campaignId"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "numberPoolId",
                  "description": "(Required) Number Pool Id that represents the Number Pool. Depending on the number pool type, it will be <br/> USE: <br/>  -  **{CampaignID}-{NNID}** for CampaignId Nmber Pool Type (exmple: CYYYYYY-999000) <br /> -  **{SubID}-{NNID}** for SubId Nmber Pool Type. (example CUST_SYN1-999000)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "numberPoolType",
                  "description": "(Required) Type of Number Pool based on SubId or based on Campaign Id; Indicative"
                }
              ]
            },
            "header": [
