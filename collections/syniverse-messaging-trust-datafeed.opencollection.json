{
  "opencollection": "1.0.0",
  "info": {
    "name": "MT Spam Datafeed",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.mt1.messaging-trust.syniverse.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit spam reports",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mt1.messaging-trust.syniverse.com/api/v1/spam/report",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a list of spam reports"
        }
      ]
    }
  ],
  "bundled": true
}